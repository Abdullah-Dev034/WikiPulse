# Copy to .env and adjust. Never commit .env.

# replay = recorded events from REPLAY_FILE (offline); live = Wikimedia EventStreams
STREAM_SOURCE=replay
REPLAY_FILE=../data/sample_events.jsonl
REPLAY_SPEED=1
REPLAY_LOOP=true
BROADCAST_INTERVAL_SECONDS=1

# Live mode only. Wikimedia's User-Agent policy (https://w.wiki/4wJS) needs contact
# details; without them the stream answers 403. Put your own project URL or email here.
# USER_AGENT=WikiPulse/0.1 (https://github.com/<you>/WikiPulse; <you>@example.com)

# Any OpenAI-compatible endpoint. Default is a local Ollama model (no key needed).
# Databricks example: LLM_BASE_URL=https://<workspace>.cloud.databricks.com/serving-endpoints
#                     LLM_MODEL=databricks-meta-llama-3-3-70b-instruct
#                     LLM_API_KEY=<personal access token with the model-serving scope>
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
PULSE_INTERVAL_SECONDS=45
