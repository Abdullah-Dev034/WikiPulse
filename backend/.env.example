# Copy to .env and adjust. Never commit .env.

# live = Wikimedia EventStreams, replay = sample_events.jsonl
STREAM_SOURCE=live
REPLAY_FILE=../sample_events.jsonl
REPLAY_SPEED=10

# Any OpenAI-compatible endpoint. Default is a local Ollama model (no key needed).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
PULSE_INTERVAL_SECONDS=45
