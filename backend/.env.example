# Copy to .env and adjust. Never commit .env.

# replay = recorded events (offline); live = Wikimedia EventStreams (lands with stream_client.py)
STREAM_SOURCE=replay
REPLAY_FILE=../data/sample_events.jsonl
REPLAY_SPEED=1
REPLAY_LOOP=true
BROADCAST_INTERVAL_SECONDS=1

# Any OpenAI-compatible endpoint. Default is a local Ollama model (no key needed).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
PULSE_INTERVAL_SECONDS=45
